# Postgres (Neon in production)
DATABASE_URL=postgres://carlog:carlog_local_dev@127.0.0.1:5433/carlog
# openssl rand -base64 32
AUTH_SECRET=
# Cloudflare R2 (without these, uploads are stored in .data/uploads — dev only)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Web push: pnpm dlx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Protects /api/cron/reminders (Vercel sends it automatically as a Bearer token)
CRON_SECRET=
